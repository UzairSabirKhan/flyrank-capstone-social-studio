generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  url
  markdown
}

enum VariantStatus {
  draft
  approved
  rejected
  published
}

model Post {
  id           String     @id @default(uuid())
  sourceType   SourceType
  sourceUrl    String?
  title        String
  bodyMarkdown String
  createdAt    DateTime   @default(now())
  variants     Variant[]
}

model Variant {
  id        String        @id @default(uuid())
  postId    String
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform  String
  text      String
  status    VariantStatus @default(draft)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  slots     Slot[]

  @@unique([postId, platform])
}

enum SlotStatus {
  scheduled
  publishing
  published
  failed
}

model Slot {
  id             String     @id @default(uuid())
  variantId      String
  variant        Variant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime
  status         SlotStatus @default(scheduled)
  idempotencyKey String     @unique
  claimedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  attempts       PublishAttempt[]

  @@index([status, scheduledAt])
}

enum AttemptResult {
  started
  published
  failed
  unknown
}

model PublishAttempt {
  id          String        @id @default(uuid())
  slotId      String
  slot        Slot          @relation(fields: [slotId], references: [id], onDelete: Cascade)
  startedAt   DateTime      @default(now())
  finishedAt  DateTime?
  result      AttemptResult @default(started)
  externalId  String?
  externalUrl String?
  error       String?

  @@index([slotId])
}

model MockPost {
  id             String   @id @default(uuid())
  platform       String
  text           String
  preview        String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
}