{
  "name": "flyrank-capstone-social-studio",
  "version": "1.0.0",
  "description": "Change one blog post into a full social campaign. This system makes one post version for each platform. A person approves each version. A scheduler publishes each approved version one time, and only one time.",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "tsx src/api.ts",
    "start:worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UzairSabirKhan/flyrank-capstone-social-studio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/UzairSabirKhan/flyrank-capstone-social-studio/issues"
  },
  "homepage": "https://github.com/UzairSabirKhan/flyrank-capstone-social-studio#readme",
  "type": "module",
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
